# Copy to .env in the project root (crewai_devops_claude/.env). .env is git-ignored.
# k8s-capacity loads it automatically; already exported variables take precedence.

# --- LLM (LiteLLM model string: provider/model) ---
CREWAI_LLM=openai/gpt-4o-mini
OPENAI_API_KEY=sk-...

# optional: different models per role (fallback: CREWAI_LLM)
# CREWAI_LLM_ANALYST=openai/gpt-4o-mini
# CREWAI_LLM_LEAD=openai/gpt-4o

# optional: OpenAI-compatible endpoint (proxy). Leave unset for api.openai.com
# OPENAI_API_BASE=http://localhost:4000

# --- `crewai run` only ---
CAPACITY_MODE=audit
CAPACITY_CONFIG=examples/kind-dev01/run_audit.yaml
# CAPACITY_SNAPSHOT=runs/kind-dev01-snapshot.json

# keep CrewAI from sending telemetry/traces
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
