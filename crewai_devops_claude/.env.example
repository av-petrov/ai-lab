# Copy to .env in the project root (crewai_devops_claude/.env). .env is git-ignored.
# The CLIs load it automatically; already exported variables take precedence.

# =====================================================================================
# LLM for the whole SRE crew (sre_common.llm): named profiles + one switch
# =====================================================================================
SRE_LLM_PROFILE=openai                          # active profile for every agent: openai | local | ...

SRE_LLM_OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-...                           # used by profiles without their own _API_KEY

# OpenAI-compatible endpoint (LiteLLM proxy, vLLM, Ollama ...): model id as listed by <base>/v1/models
# SRE_LLM_LOCAL_MODEL=openai/<model-id>
# SRE_LLM_LOCAL_BASE_URL=https://<host>/v1
# SRE_LLM_LOCAL_API_KEY=...
# SRE_LLM_LOCAL_CONTEXT_WINDOW=262144           # model's max_input_tokens (CrewAI assumes 8192 for unknown models)
# SRE_LLM_LOCAL_TIMEOUT=300                     # seconds per call (local models can be slow)
# SRE_LLM_LOCAL_TEMPERATURE=0.1

# optional per-agent override (agent name upper-cased):
# SRE_LLM_PROFILE_ARGOCD_OBSERVABILITY=local
# SRE_LLM_PROFILE_K8S_CAPACITY_ANALYST=local
# SRE_LLM_PROFILE_K8S_CAPACITY_LEAD=openai
# one-off: argocd-observe --llm-profile local ...

# legacy, used only when no profile is selected: CREWAI_LLM / CREWAI_LLM_ANALYST / CREWAI_LLM_LEAD (k8s-capacity),
# MODEL then CREWAI_LLM (argocd-observe); endpoint from OPENAI_API_BASE

# --- `crewai run` only ---
CAPACITY_MODE=audit
CAPACITY_CONFIG=examples/kind-dev01/run_audit.yaml
# CAPACITY_SNAPSHOT=runs/kind-dev01-snapshot.json

# keep CrewAI from sending telemetry/traces
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# =====================================================================================
# argocd-observability (argocd-observe): agent-specific settings only. Everything optional; defaults shown.
# (its LLM comes from the crew-wide SRE_LLM_* profiles above)
# =====================================================================================

# auth mode: auto (Argo CD API if token set, else kube current-context) | kube | argocd
ARGOCD_OBS_AUTH_MODE=auto
ARGOCD_NAMESPACE=argocd

# --- mode argocd: read-only local account (deploy/argocd-readonly-account) ---
# kubectl -n argocd port-forward svc/argocd-server 18081:80  (server.insecure=true on kind-dev01; or make argocd-ui ARGOCD_UI_PORT=18081 in k8s-lab/kind)
# ARGOCD_SERVER=localhost:18081
# ARGOCD_PLAINTEXT=true          # http:// (port-forward to :80 of an insecure server)
# ARGOCD_INSECURE=false          # https with an unverified (self-signed) certificate
# ARGOCD_AUTH_TOKEN=             # from deploy/argocd-readonly-account/generate-token.sh

# --- mode kube: default is the CURRENT context of $KUBECONFIG / ~/.kube/config ---
# ARGOCD_OBS_KUBECONFIG=.kube/argocd-observer.kubeconfig   # read-only SA (deploy/kube-readonly)
# ARGOCD_OBS_KUBE_CONTEXT=                                  # explicit override (default: current)

# --- metrics (auto-detected: Prometheus -> Argo CD /metrics via API proxy -> metrics-server) ---
# PROMETHEUS_URL=http://localhost:9090
# ARGOCD_OBS_SCRAPE_METRICS=true
# ARGOCD_OBS_METRICS_TIMEOUT=5

# --- limits ---
# ARGOCD_OBS_LOG_TAIL_LINES=200
# ARGOCD_OBS_LOG_TAIL_MAX=1000
# ARGOCD_OBS_HTTP_TIMEOUT=15
# ARGOCD_OBS_MAX_TOOL_OUTPUT_CHARS=12000
# ARGOCD_OBS_PROGRESSING_THRESHOLD_MINUTES=10
# ARGOCD_OBS_MAX_ITER=25
# ARGOCD_OBS_MAX_EXECUTION_TIME=900
